<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>axisforge_bringup</name>
  <version>0.1.0</version>
  <description>Launch files and configuration for the AxisForge printing system.</description>
  <maintainer email="z5311131@ad.unsw.edu.au">Abdul Shahzeb</maintainer>
  <license>OpenSSL</license>

  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>ur_control</exec_depend>
  <exec_depend>print_control</exec_depend>
  <exec_depend>extrusion_control</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ros2launch</exec_depend>
  <exec_depend>ur_robot_driver</exec_depend>
  <exec_depend>xterm</exec_depend>


  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
